# ---- API ----
# Comma-separated keys accepted in the X-API-Key header. Required.
RR_API_KEYS=change-me-long-random-key
RR_MAX_UPLOAD_MB=10
RR_MIN_IMAGE_SIDE=300
RR_REQUEST_TIMEOUT_S=90
RR_LOG_LEVEL=INFO

# ---- engines run on every receipt (comma-separated: vlm, tesseract, easyocr) ----
RR_ENGINES=vlm,tesseract

# ---- Engine A: vision-language model ----
# Images are sent to a cloud provider ONLY when this is true. Default: false (owner decision).
# Cloud also needs: pip install -r requirements-cloud.txt
RR_ALLOW_CLOUD_VLM=false
# anthropic | openai_compatible | none
RR_VLM_PROVIDER=none
# Cloud (Anthropic):        RR_VLM_PROVIDER=anthropic  RR_VLM_MODEL=claude-opus-5-5  RR_VLM_API_KEY=sk-ant-...
# Self-hosted (vLLM/Ollama): RR_VLM_PROVIDER=openai_compatible RR_VLM_BASE_URL=http://vlm:8000/v1 RR_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
RR_VLM_MODEL=claude-opus-5-5
RR_VLM_BASE_URL=
RR_VLM_API_KEY=
# Force self-hosted/cloud classification of an openai_compatible endpoint (auto-detected from the host otherwise)
# RR_VLM_SELF_HOSTED=true
RR_VLM_EFFORT=high
RR_VLM_TIMEOUT_S=60
RR_VLM_STRIP_REREAD=true

# ---- Engine B: Tesseract ----
# RR_TESSERACT_CMD=/usr/bin/tesseract
# RR_TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
RR_TESSERACT_LANGS=fas+eng

# ---- rules ----
RR_DATE_MAX_AGE_DAYS=3
RR_NAME_MATCH_THRESHOLD=85
# EasyOCR outputs Arabic «٥» for both 5 and the circle-shaped Persian zero: treat it as unreadable
RR_EASYOCR_AMBIGUOUS_FIVE=true
